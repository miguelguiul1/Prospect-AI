# Copie este arquivo para `.env` (na pasta backend/) e ajuste conforme
# necessário para desenvolvimento local. NUNCA coloque valores reais de
# produção neste arquivo de exemplo, nem em `.env` (que é ignorado pelo Git).

# development | test | production
APP_ENV=development
APP_NAME=Prospect AI
LOG_LEVEL=INFO

# Ajuste host/porta/usuário/senha/banco conforme seu PostgreSQL local ou o
# serviço `postgres` do docker-compose (ver infra/README.md).
DATABASE_URL=postgresql+psycopg://prospect:prospect@localhost:5432/prospect_ai

REDIS_URL=redis://localhost:6379/0

# Lista JSON de origens permitidas por CORS.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Discovery (Fase 1) ------------------------------------------------
# Chave da Google Maps Platform com a "Places API (New)" habilitada.
# NUNCA coloque um valor real aqui nem em qualquer commit — apenas em
# backend/.env (ignorado pelo Git). Sem esta chave, o backend inicia
# normalmente e o provider Google fica indisponível de forma controlada
# (POST /api/discovery/search retorna erro, não crash). Ver docs/discovery.md.
GOOGLE_MAPS_API_KEY=your_key_here

# google_places é o único provider implementado nesta fase.
DISCOVERY_PROVIDER=google_places

DISCOVERY_HTTP_CONNECT_TIMEOUT_SECONDS=5.0
DISCOVERY_HTTP_READ_TIMEOUT_SECONDS=10.0
DISCOVERY_HTTP_MAX_RETRIES=3
DISCOVERY_HTTP_BACKOFF_BASE_SECONDS=0.5
DISCOVERY_HTTP_BACKOFF_MAX_SECONDS=8.0
DISCOVERY_PAGE_TOKEN_DELAY_SECONDS=0.0

DISCOVERY_MAX_RESULTS_HARD_CAP=60
DISCOVERY_MAX_PAGES_HARD_CAP=3

# Custo estimado por chamada à API, se você quiser rastrear custo. Deixe em
# branco para não estimar custo (nenhum valor de preço é assumido pelo
# código) — ver docs/discovery.md, seção "Custos".
DISCOVERY_COST_PER_REQUEST=
DISCOVERY_COST_CURRENCY=USD

DISCOVERY_CACHE_TTL_SECONDS=86400

# --- Identity Resolution (Fase 2) ---------------------------------------
# Limiares de similaridade (0-100) e distância (metros) usados como sinais
# de apoio no matching — nunca sozinhos. Hipóteses iniciais, sujeitas a
# recalibração com dados reais. Ver docs/identity-resolution.md.
IDENTITY_NAME_SIMILARITY_THRESHOLD=75
IDENTITY_ADDRESS_SIMILARITY_THRESHOLD=85
IDENTITY_GEO_PROXIMITY_METERS=150.0

# --- Digital Audit (Fase 3) ----------------------------------------------
# Ver docs/digital-audit.md.
AUDIT_HTTP_CONNECT_TIMEOUT_SECONDS=5.0
AUDIT_HTTP_READ_TIMEOUT_SECONDS=10.0
AUDIT_HTTP_MAX_RETRIES=1
AUDIT_HTTP_BACKOFF_BASE_SECONDS=0.5
AUDIT_HTTP_BACKOFF_MAX_SECONDS=4.0
AUDIT_HTTP_MAX_REDIRECTS=5
AUDIT_HTTP_MAX_RESPONSE_BYTES=2000000

# Identifica o auditor perante o site de terceiro — troque pelo contato
# real da sua operação antes de auditar em produção.
AUDIT_HTTP_USER_AGENT=ProspectAI-DigitalAudit/1.0

# --- Sales Brief (Fase 4) ------------------------------------------------
# Ver docs/sales-brief.md. Sem ANTHROPIC_API_KEY, o backend inicia
# normalmente e o Opportunity Score continua funcionando — só
# POST /api/sales-brief/{company_id} responde com status=failed de forma
# controlada (nunca crash, nunca um briefing inventado). NUNCA versione uma
# chave real.
ANTHROPIC_API_KEY=

# Confira o identificador de modelo atual na documentação da Anthropic antes
# de configurar em produção — este default não é garantia de disponibilidade.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
ANTHROPIC_HTTP_CONNECT_TIMEOUT_SECONDS=5.0
ANTHROPIC_HTTP_READ_TIMEOUT_SECONDS=30.0
ANTHROPIC_MAX_TOKENS=1500

# --- Reservado para fases futuras -----------------------------------------
# Nenhuma destas variáveis é lida por nenhuma Fase 0-4. Preencha apenas
# quando a integração correspondente for implementada.
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
